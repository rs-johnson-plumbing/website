# R.S. Johnson Plumbing website — environment variables
#
# Nothing here is required for the site to build or render. The site is fully
# static; the production URL lives in content/site.json (siteUrl).
#
# Search indexing. Every page carries noindex until this is exactly "true".
# Set it in Vercel (Production environment) at launch.
NEXT_PUBLIC_SITE_INDEXABLE=

# These are wired in step 7 (SEO layer, analytics, form stubs). Add them in
# Vercel → Project → Settings → Environment Variables when each service exists.

# GA4 measurement ID (G-XXXXXXXXXX). Leave unset to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend API key for form notification emails (Message Us / Request a Bid).
RESEND_API_KEY=

# Housecall Pro lead intake. Exact shape depends on how HCP accepts leads.
HOUSECALL_PRO_WEBHOOK_URL=

# Cloudflare Turnstile (only if we use it instead of Vercel bot protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Blob token for the bid-form plans upload. Vercel adds this
# automatically when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Optional RoboRyan API: server-only keys, never NEXT_PUBLIC_. Both flags default off.
OPENAI_API_KEY=
# OpenAI speech uses gpt-4o-mini-tts / cedar when the key is present.
# Set false to disable it independently of chat AI and web search.
ROBO_RYAN_TTS_ENABLED=true
OPENAI_MODEL=
ROBO_RYAN_AI_ENABLED=false
ROBO_RYAN_WEB_SEARCH_ENABLED=false

# Product-label photo reading. Model must support image input and structured outputs.
ROBO_RYAN_VISION_ENABLED=false
# Optional override; otherwise uses OPENAI_MODEL.
OPENAI_VISION_MODEL=

# Chat research follow-up: fixed recipient is daren.ungerboeck@gmail.com.
# Requires RESEND_API_KEY above and a verified sender. Explicit opt-in defaults off.
ROBO_RYAN_FOLLOWUP_ENABLED=false
ROBO_RYAN_FOLLOWUP_FROM=
